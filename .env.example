# ==========================================
# 🌿 Carbyn UAE Compliance Platform - Environment Configuration
# ==========================================

# 1. MongoDB Database (Optional for demo, required for persistent cluster storage)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/carbyn?retryWrites=true&w=majority
MONGODB_URI=

# 2. Authentication & JWT Security
# Set a strong random secret key for signing user sessions
JWT_SECRET=carbyn-uae-secret-key-2026-super-secure

# 3. Cloudinary (For Utility Bill OCR uploads, receipt storage, and MOCCAE PDF archival)
# Get credentials from your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 4. Stripe Payment Gateway (For AED Subscriptions & One-Time Reports)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# 5. Production App URL (Optional, defaults to request host/origin on Vercel)
NEXT_PUBLIC_APP_URL=
