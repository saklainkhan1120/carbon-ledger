# Environment Variables for CarbonLedger Deployment
# (All variables are optional for demo/prototype mode; app operates with in-memory fallbacks)

# MongoDB Database Connection (Optional for persistent DB)
MONGODB_URI=

# Stripe Payment Gateway (Optional for live AED subscriptions)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Production App URL (Optional, defaults to request origin)
NEXT_PUBLIC_APP_URL=
